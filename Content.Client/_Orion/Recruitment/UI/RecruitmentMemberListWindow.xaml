<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'recruitment-list-ui-title'}"
                      MinSize="640 350"
                      SetSize="640 350">
    <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="5">
        <controls:StripeBack>
            <PanelContainer>
                <Label Name="OrganizationLabel"
                       Text="{Loc 'recruitment-member-label'}"
                       Align="Center"
                       StyleClasses="LabelHeading"/>
            </PanelContainer>
        </controls:StripeBack>

        <ScrollContainer Name="MemberScroller"
                         VerticalExpand="True"
                         HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal"
                          HorizontalExpand="True"
                          SeparationOverride="5"
                          Margin="5">
                <!-- Column 1: Name -->
                <BoxContainer Name="NameColumn"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              SeparationOverride="3"
                              MinWidth="200">
                    <!-- Header and members added here dynamically -->
                </BoxContainer>

                <!-- Column 2: Recruiter -->
                <BoxContainer Name="RecruiterColumn"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              SeparationOverride="3"
                              MinWidth="180">
                    <!-- Header and members added here dynamically -->
                </BoxContainer>

                <!-- Column 3: Time -->
                <BoxContainer Name="TimeColumn"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              SeparationOverride="3"
                              MinWidth="150">
                    <!-- Header and members added here dynamically -->
                </BoxContainer>
            </BoxContainer>
        </ScrollContainer>

        <Label Name="NoMembersLabel"
               Text="{Loc 'recruitment-member-list-empty'}"
               StyleClasses="LabelHeading"
               FontColorOverride="Gray"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visible="false"/>

        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider"/>
            <BoxContainer Orientation="Horizontal" Margin="5">
                <Label Name="MemberCountLabel"
                       Text="{Loc 'recruitment-member-list-count'}"
                       StyleClasses="LabelSubText"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="5"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
