<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'recruitment-list-ui-title'}"
                      MinSize="540 280"
                      SetSize="540 280">
    <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="5">
        <controls:StripeBack>
            <PanelContainer>
                <Label Name="OrganizationLabel"
                       Text="{Loc 'recruitment-member-label'}"
                       Align="Center"
                       StyleClasses="LabelHeading"/>
            </PanelContainer>
        </controls:StripeBack>

        <Label Name="MemberCountLabel"
               Text="{Loc 'recruitment-member-list-count'}"
               StyleClasses="LabelSubText"
               Margin="5"/>

        <ScrollContainer Name="MemberScroller"
                         VerticalExpand="True"
                         HorizontalExpand="True">
            <BoxContainer Name="MembersContainer"
                          Orientation="Vertical"
                          HorizontalExpand="True"
                          SeparationOverride="5">
                <!-- Member rows will be added here dynamically -->
            </BoxContainer>
        </ScrollContainer>

        <Label Name="NoMembersLabel"
               Text="{Loc 'recruitment-member-list-empty'}"
               StyleClasses="LabelHeading"
               FontColorOverride="Gray"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visible="false"/>

        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider"/>
            <BoxContainer Orientation="Horizontal" Margin="5">
                <Label Text="{Loc 'recruitment-member-list-footer'}"
                       StyleClasses="WindowFooterText"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
