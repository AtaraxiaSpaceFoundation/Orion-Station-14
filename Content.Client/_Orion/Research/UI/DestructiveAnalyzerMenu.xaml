<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
                      Title="{Loc 'research-machine-destructive-window-title'}"
                      SetSize="560 460"
                      MinSize="480 360">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="ServerLabel" StyleClasses="LabelHeading"/>
        <RichTextLabel Name="BalanceLabel"/>
        <Button Name="ServerButton" Text="{Loc 'research-machine-common-server-list'}"/>

        <PanelContainer VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="4">
                <Label Text="{Loc 'research-machine-destructive-requirements-title'}" StyleClasses="LabelSubText"/>
                <RichTextLabel Name="RequirementsLabel"/>
                <Control MinHeight="8"/>
                <Label Text="{Loc 'research-machine-common-last-operation-title'}" StyleClasses="LabelSubText"/>
                <RichTextLabel Name="LastOperationLabel"/>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
