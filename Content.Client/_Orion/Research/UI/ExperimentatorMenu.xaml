<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
                      Title="{Loc 'research-machine-experimentator-window-title'}"
                      SetSize="700 540"
                      MinSize="600 440">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <controls:StripeBack>
            <Label Name="ServerLabel" StyleClasses="LabelHeading" Margin="6 4"/>
        </controls:StripeBack>
        <RichTextLabel Name="BalanceLabel"/>
        <Button Name="ServerButton" Text="{Loc 'research-machine-common-server-list'}"/>

        <PanelContainer VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
                    <Label Name="InsertedItemLabel"/>
                    <Button Name="PerformButton" Text="{Loc 'research-machine-experimentator-perform'}"/>
                    <controls:StripeBack>
                        <Label Text="{Loc 'research-machine-experimentator-requirements-title'}" StyleClasses="LabelSubText" Margin="6 2"/>
                    </controls:StripeBack>
                    <PanelContainer>
                        <RichTextLabel Name="OperationsLabel" Margin="6"/>
                    </PanelContainer>

                    <controls:StripeBack>
                        <Label Text="{Loc 'research-machine-common-last-operation-title'}" StyleClasses="LabelSubText" Margin="6 2"/>
                    </controls:StripeBack>
                    <RichTextLabel Name="LastOperationLabel"/>
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
