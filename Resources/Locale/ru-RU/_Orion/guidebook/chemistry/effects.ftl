reagent-effect-guidebook-add-moodlet =
    Изменяет настроение на {$amount}
    и длится {$timeout} секунд.

reagent-effect-guidebook-remove-moodlet =
    Удаляет мудлет {$name}.

reagent-effect-guidebook-purge-moodlets =
    Удаляет все активные непостоянные мудлеты.

reagent-effect-guidebook-oxygenate =
    { $chance ->
        [1] Улучшает оксигенацию на { NATURALFIXED($factor, 1) } и замедляет дальнейшее получение урона от удушья
       *[other] Улучшают оксигенацию на { NATURALFIXED($factor, 1) } и замедляют дальнейшее получение урона от удушья
    }
